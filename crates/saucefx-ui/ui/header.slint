// Title bar: frontend/src/components/AppHeader.tsx and styles.css:186-260.
import { Layout, Palette, Typography } from "palette.slint";

export component GlyphButton inherits Rectangle {
    in property <string> glyph: "gear";
    in property <bool> danger: false;
    in property <bool> keyboard-enabled: true;
    in property <length> button-width: Layout.icon-button;
    out property <bool> keyboard-focused: focus.has-focus;
    public function take-focus() { focus.focus(); }
    callback clicked();
    width: root.button-width;
    height: Layout.icon-button;
    border-radius: 7px;
    background: touch.has-hover ? (danger ? Palette.danger-wash : Palette.surface-hover) : transparent;

    focus := FocusScope {
        enabled: root.keyboard-enabled;
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == "\u{000a}" || event.text == "\u{0020}") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }

    // Icon glyphs: muted like styles.css .icon-button, text color on hover.
    // Slint stroke-width is in element pixels (it insets the viewbox by half
    // the stroke), so the lucide 1.9 units at 24 become 1.19px at 15px.
    if glyph == "minus" : Path {
        x: (parent.width - 15px) / 2;
        y: (parent.height - 15px) / 2;
        width: 15px;
        height: 15px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke-width: 1.19px;
        stroke-line-cap: round;
        stroke: touch.has-hover ? Palette.text : Palette.muted;
        commands: "M 5 12 L 19 12";
    }

    if glyph == "close" : Path {
        // Slint fits the viewbox into width - stroke, so the fitted ink of a
        // 15px lucide X is ~0.6px smaller than the reference. The 16.2px box
        // (still centred in the 30px button) restores the reference 8.7px ink.
        x: (parent.width - 16.2px) / 2;
        y: (parent.height - 16.2px) / 2;
        width: 16.2px;
        height: 16.2px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke-width: 1.19px;
        stroke-line-cap: round;
        stroke: touch.has-hover ? Palette.text : Palette.muted;
        commands: "M 18 6 L 6 18 M 6 6 L 18 18";
    }

    // AppHeader.tsx uses lucide `Settings2`: two lines with round knobs.
    // Circles are cubic-approximated (Slint paths have no arc command).
    if glyph == "gear" : Path {
        x: (parent.width - 15px) / 2;
        y: (parent.height - 15px) / 2;
        width: 15px;
        height: 15px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke-width: 1.19px;
        stroke-line-cap: round;
        stroke: touch.has-hover ? Palette.text : Palette.muted;
        commands: "M 20 7 L 11 7 M 14 17 L 5 17 M 4 7 C 4 5.343 5.343 4 7 4 C 8.657 4 10 5.343 10 7 C 10 8.657 8.657 10 7 10 C 5.343 10 4 8.657 4 7 Z M 14 17 C 14 15.343 15.343 14 17 14 C 18.657 14 20 15.343 20 17 C 20 18.657 18.657 20 17 20 C 15.343 20 14 18.657 14 17 Z";
    }
}

export component PowerPill inherits Rectangle {
    in property <bool> on: true;
    in property <bool> keyboard-enabled: true;
    callback toggled();
    // Keyboard reachability: the reference is a labelled Base UI switch, so
    // Enter/Space toggle it and focus can land here via Tab.
    out property <bool> keyboard-focused: pill-focus.has-focus;
    width: 58px;
    height: Layout.power-control-height;
    border-radius: Layout.power-control-radius;
    // styles.css .power-control: base transparent/muted, hover
    // surface-hover/text, checked accent-wash/text (checked hover
    // accent-wash-strong), focus ring accent.
    background: on
        ? (ta.has-hover ? Palette.accent-wash-strong : Palette.accent-wash)
        : (ta.has-hover || pill-focus.has-focus ? Palette.surface-hover : transparent);
    border-width: 1px;
    border-color: pill-focus.has-focus ? Palette.accent : transparent;

    pill-focus := FocusScope {
        enabled: root.keyboard-enabled;
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.toggled();
                return accept;
            }
            reject
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { pill-focus.focus(); root.toggled(); }
    }

    content := Rectangle {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        // AppHeader.tsx uses the lucide `Power` icon (24-unit grid, drawn at
        // 13px with a 2.2 stroke), not a status dot.
        icon := Rectangle {
            x: 0;
            // Reference icon box y20 for a pill at y11.5 (11.5 + 8.5).
            y: (parent.height - 13px) / 2;
            width: 13px;
            height: 13px;
            background: transparent;
            Path {
                width: 13px;
                height: 13px;
                viewbox-width: 24;
                viewbox-height: 24;
                // The reference lucide stroke (2.2 units at 24) scales to
                // 1.19 element pixels at this size.
                stroke-width: 1.19px;
                stroke-line-cap: round;
                stroke: root.on ? Palette.accent : (ta.has-hover ? Palette.text : Palette.muted);
                commands: "M 12 2 L 12 12 M 18.36 6.64 A 9 9 0 1 1 5.63 6.64";
            }
        }
        Text {
            // 13px icon + the reference 6px icon/label gap; label box x886.
            x: icon.width + 6px;
            y: (parent.height - 11px) / 2;
            height: 11px;
            text: root.on ? "ON" : "OFF";
            color: root.on || ta.has-hover ? Palette.text : Palette.muted;
            font-family: Typography.family;
            // styles.css .power-label: 10.5px / 600, 0.045em tracking.
            font-size: 10.5px;
            font-weight: 600;
            letter-spacing: 0.47px;
            vertical-alignment: center;
        }
    }
}

export component AppHeader inherits Rectangle {
    in property <bool> power: true;
    in property <bool> keyboard-enabled: true;
    out property <bool> power-focused: power-pill.keyboard-focused;
    public function focus-settings-opener() { settings-opener.take-focus(); }
    callback power-toggled();
    callback settings-clicked();
    callback minimize-clicked();
    callback close-clicked();
    callback drag-requested();

    width: Layout.window-width;
    height: Layout.header-height;
    background: Palette.bg-elevated;

    // styles.css .titlebar only draws a bottom border; the outer 1px shell
    // border is the frame, so the bar must not add a second one.
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Palette.border-subtle;
    }

    // The native window is fixed at 1040x568, so the title bar positions its two
    // groups explicitly instead of relying on layout stretch (which collapsed
    // the actions into the middle of the bar).
    drag-area := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 250px;
        height: parent.height;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.drag-requested();
            }
        }
    }

    // styles.css .brand: 29px mark at the titlebar padding edge, a 10px gap,
    // then the name/subtitle stack centred in the 52px bar. Explicit positions
    // because a layout pins the fixed-height mark to the top instead of
    // centring it.
    brand := Rectangle {
        // The frame already insets this bar by 1px; the reference brand mark
        // sits at x18 (styles.css padding-left 17 + the 1px shell border).
        x: Layout.header-pad-left - 1px;
        y: 0;
        width: Layout.brand-min-width;
        height: Layout.header-height;
        background: transparent;

        Image {
            x: 0;
            // The 1px title-bar bottom border leaves a 51px content box, so
            // the 29px mark centres at y12 instead of y12.5.
            y: (parent.height - 1px - Layout.brand-mark-height) / 2;
            width: Layout.brand-mark-width;
            height: Layout.brand-mark-height;
            source: @image-url("../../../frontend/public/saucefx-mark.svg");
            image-fit: contain;
        }

        VerticalLayout {
            x: Layout.brand-mark-width + Layout.brand-gap;
            y: 0;
            width: 160px;
            height: parent.height - 1px;
            spacing: 2px;
            alignment: center;
            Text {
                text: "SauceFX";
                color: Palette.text;
                font-family: Typography.family;
                font-size: Typography.brand;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: "AUDIO ENHANCER";
                color: Palette.muted-2;
                font-family: Typography.family;
                font-size: 8.5px;
                font-weight: 600;
                letter-spacing: 1.1px;
                vertical-alignment: center;
            }
        }
    }

    actions := HorizontalLayout {
        // Reference right edge is x1028: header-pad-right minus the 1px frame
        // inset that is already part of this bar's x position.
        x: parent.width - self.width - (Layout.header-pad-right - 1px);
        // Centred by hand: a layout outside a layout keeps its preferred
        // height, so asking for the full bar height would pin it to the top.
        // The reference pill top is y11.5 (not 12), i.e. 10.5 inside the bar.
        y: (Layout.header-height - Layout.power-control-height) / 2 - 0.5px;
        width: 171px;
        height: Layout.power-control-height;
        spacing: 3px;
        alignment: center;

        power-pill := PowerPill {
            on: root.power;
            keyboard-enabled: root.keyboard-enabled;
            toggled => { root.power-toggled(); }
        }
        Rectangle {
            width: 13px;
            height: 20px;
            background: transparent;
            Rectangle {
                x: 6px;
                width: 1px;
                height: parent.height;
                background: Palette.border-subtle;
            }
        }
        settings-opener := GlyphButton {
            glyph: "gear";
            keyboard-enabled: root.keyboard-enabled;
            clicked => { root.settings-clicked(); }
        }
        GlyphButton { glyph: "minus"; button-width: 30px; keyboard-enabled: root.keyboard-enabled; clicked => { root.minimize-clicked(); } }
        GlyphButton { glyph: "close"; button-width: 30px; danger: true; keyboard-enabled: root.keyboard-enabled; clicked => { root.close-clicked(); } }
    }
}
