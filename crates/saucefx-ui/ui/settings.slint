// Source-equivalent Settings dialog (frontend/src/components/SettingsDialog.tsx
// + styles.css .settings-*): appearance row, accent swatches + custom button,
// preset import/export/save actions, start-at-login switch and the version footer.
import { Layout, Palette, Typography } from "palette.slint";

component SwatchButton inherits Rectangle {
    in property <color> swatch;
    in property <bool> pressed: false;
    in property <bool> focused: false;
    in property <bool> custom: false;
    callback picked();

    // styles.css .swatch-button:hover scales the button 1.06; Slint has no
    // transform, so the visible ink (dot, glyph, check) grows around the
    // centre of the fixed 24px slot instead.
    property <float> hover-scale: touch.has-hover ? 1.06 : 1.0;

    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: transparent;
    border-width: custom ? 1px : 0px;
    border-color: Palette.border;

    if pressed || focused : Rectangle {
        // Reference .swatch-button[data-pressed] uses a 3.5px accent ring
        // outside a 2px surface gap (`0 0 0 2px`, then `0 0 0 3.5px`).
        // Width/x stay at the exact left/right edges (x580/763). The height
        // is 1px taller than the width because the reference's bottom
        // anti-aliased band has 4 coloured pixels at y258 while a 31px box
        // ends at y257; the extra row is added downward only, so the top
        // row (y227) and the card/separators do not move.
        width: parent.width + 7px;
        height: parent.height + 8px;
        x: -3.5px;
        y: -3.5px;
        border-radius: (parent.width + 4px) / 2;
        border-width: 1.5px;
        border-color: Palette.accent;
        background: transparent;
    }

    Rectangle {
        width: 16px * hover-scale;
        height: 16px * hover-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: custom ? (root.pressed ? root.swatch : Palette.surface-2) : swatch;
    }

    // The reference custom label shows the lucide `Palette` glyph on the
    // neutral dot until a custom colour is active (then the check replaces
    // it). Its hover brightens with `.swatch-button-custom:hover .swatch-custom`.
    if custom && !pressed : Path {
        width: 11px * hover-scale;
        height: 11px * hover-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke-width: 0.87px;
        stroke-line-cap: round;
        stroke: touch.has-hover ? Palette.text-soft : Palette.muted;
        commands: "M 12 2 C 6.49 2 2 6.49 2 12 C 2 17.51 6.49 22 12 22 C 12.93 22 13.65 21.25 13.65 20.31 C 13.65 19.87 13.47 19.48 13.21 19.19 C 12.92 18.9 12.77 18.54 12.77 18.06 C 12.77 17.14 13.52 16.39 14.44 16.39 L 16.44 16.39 C 19.49 16.39 22 13.89 22 10.83 C 22 6.01 17.46 2 12 2 Z M 13.5 6.13 L 13.5 6.87 M 17.5 10.13 L 17.5 10.87 M 8.5 7.13 L 8.5 7.87 M 6.5 12.13 L 6.5 12.87";
    }

    if pressed : Text {
        text: "\u{2713}";
        width: 16px * hover-scale;
        height: 16px * hover-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        color: custom ? #ffffff : #ffffff;
        font-size: 9px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

export component SettingsDialog inherits Rectangle {
    in property <bool> light: false;
    in property <bool> custom-accent: false;
    in property <string> custom-hex-text: "";
    in property <int> accent-index: 0;
    in property <bool> autostart: false;
    in property <string> accent-label: "Rose";
    in property <string> version: "0.2.4";
    in property <string> save-error: "";
    callback theme-changed(bool);
    callback accent-chosen(int);
    callback custom-accent-clicked();
    callback custom-accent-text-changed(string);
    callback autostart-changed(bool);
    callback import-clicked();
    callback export-clicked();
    callback save-opened();
    callback quit-clicked();
    callback closed();
    callback focus-changed(string);
    in property <int> refocus-count: 0;

    out property <bool> modal-focused: fs.has-focus;
    private property <int> focus-index: 0;
    changed focus-index => { root.focus-changed("settings:" + root.focus-index); }
    // Only restore focus when the dialog is actually on screen; a Save that
    // was opened outside Settings must not pull focus into a hidden dialog.
    changed refocus-count => { if (self.visible) { root.focus-modal(); } }
    // A fresh open focuses the Close button, as the Base UI dialog does.
    changed visible => { if (self.visible) { root.select(0); } }
    // Re-edits that the host rejected (or canonicalised) restore the bound
    // text, because the first typed edit breaks the `text:` binding on the
    // input below.
    changed custom-hex-text => { hex-input.text = root.custom-hex-text; }
    width: 604px;
    height: content.preferred-height;
    border-radius: 14px;
    background: Palette.surface;
    border-width: 1px;
    border-color: Palette.border;
    // styles.css .dialog uses overflow: hidden, so the section backgrounds
    // must not square off the card's rounded corners.
    clip: true;

    // Manual focus chain: Tab/Backtab are consumed here so focus cannot leave
    // the modal, and Enter/Space activate the focused action. Slint maps
    // Backtab to U+0019 when the backend reports it, but the winit/X11 path
    // delivers Shift+Tab as "\t" with the shift modifier, so both are handled.
    // Blocks backdrop clicks from reaching the dismiss layer underneath.
    card-block := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        clicked => { root.focus-modal(); }
    }

    fs := FocusScope {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == "\u{0009}" && !event.modifiers.shift) {
                root.focus-index = root.next-focus(root.focus-index);
                return accept;
            }
            if (event.text == "\u{0019}" || (event.text == "\u{0009}" && event.modifiers.shift)) {
                root.focus-index = root.prev-focus(root.focus-index);
                return accept;
            }
            if (event.text == "\u{000a}" || event.text == "\u{0020}") {
                root.activate(root.focus-index);
                return accept;
            }
            if (event.text == "\u{001b}") {
                root.closed();
                return accept;
            }
            reject
        }

        // Capture runs window -> focused item before key-pressed. It handles
        // the modal navigation keys only (Escape/Tab/Backtab), so an embedded
        // text field cannot consume them, while Enter/Space still reach the
        // focused control first and keep their normal meaning there.
        capture-key-pressed(event) => {
            if (event.text == "\u{0009}" && !event.modifiers.shift) {
                root.focus-index = root.next-focus(root.focus-index);
                return accept;
            }
            if (event.text == "\u{0019}" || (event.text == "\u{0009}" && event.modifiers.shift)) {
                root.focus-index = root.prev-focus(root.focus-index);
                return accept;
            }
            if (event.text == "\u{001b}") {
                root.closed();
                return accept;
            }
            reject
        }
    }

    // Traversal follows the protected SettingsDialog.tsx DOM, not the numeric
    // action IDs: Close(0), Dark(1), Light(2), accents(3-8), custom(9),
    // Import(11), Export(12), Save preset(13), Start at login(10), Quit(14).
    // IDs and callbacks (including the restored Save=13) are unchanged.
    pure function next-focus(index: int) -> int {
        if index == 0 { return 1; }
        if index == 1 { return 2; }
        if index == 2 { return 3; }
        if index == 3 { return 4; }
        if index == 4 { return 5; }
        if index == 5 { return 6; }
        if index == 6 { return 7; }
        if index == 7 { return 8; }
        if index == 8 { return 9; }
        if index == 9 { return 11; }
        if index == 11 { return 12; }
        if index == 12 { return 13; }
        if index == 13 { return 10; }
        if index == 10 { return 14; }
        return 0;
    }

    pure function prev-focus(index: int) -> int {
        if index == 0 { return 14; }
        if index == 14 { return 10; }
        if index == 10 { return 13; }
        if index == 13 { return 12; }
        if index == 12 { return 11; }
        if index == 11 { return 9; }
        if index == 9 { return 8; }
        if index == 8 { return 7; }
        if index == 7 { return 6; }
        if index == 6 { return 5; }
        if index == 5 { return 4; }
        if index == 4 { return 3; }
        if index == 3 { return 2; }
        if index == 2 { return 1; }
        return 0;
    }

    // Restores keyboard focus to the dialog without resetting the focused
    // action: reopening Settings after Save returns to the Save opener.
    public function focus-modal() {
        fs.focus();
        root.focus-changed("settings:" + root.focus-index);
    }

    // Pointer activation moves the keyboard target to the clicked action, so a
    // following Enter repeats that action instead of hitting Close.
    public function select(index: int) {
        root.focus-index = index;
        fs.focus();
    }

    // Computed from the live focus scope, so a test never depends on event
    // ordering when a dialog becomes visible.
    public pure function report() -> string {
        return fs.has-focus ? "settings:" + focus-index : "settings:none";
    }

    public function activate(index: int) {
        if (index == 0) { root.closed(); }
        else if (index == 1) { root.theme-changed(false); }
        else if (index == 2) { root.theme-changed(true); }
        else if (index >= 3 && index <= 8) { root.accent-chosen(index - 3); }
        else if (index == 9) { root.custom-accent-clicked(); }
        else if (index == 10) { root.autostart-changed(!root.autostart); }
        else if (index == 11) { root.import-clicked(); }
        else if (index == 12) { root.export-clicked(); }
        else if (index == 13) { root.save-opened(); }
        else if (index == 14) { root.quit-clicked(); }
    }

    // A hidden dialog must not own the window focus (a later pointer event
    // would drop it via the runtime's invisible-focus guard); focus is granted
    // only when the dialog becomes visible.
    content := VerticalLayout {
        spacing: 0px;

        // Header: title, description, close.
        Rectangle {
            background: Palette.surface;

            HorizontalLayout {
                padding-left: 21px;
                // The 1px dialog border is not an inset in Slint; 22px here
                // puts the 28px close button at the reference x772.
                padding-right: 22px;
                padding-top: 19px;
                // Rendered header was 72px vs the reference 71px, so 15px
                // bottom padding (one less than round 6) restores the boundary.
                padding-bottom: 15px;
                spacing: 20px;
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Settings";
                        color: Palette.text;
                        font-family: Typography.family;
                        font-size: 17px;
                        font-weight: 600;
                        letter-spacing: -0.1px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Appearance, presets, and startup behavior.";
                        color: Palette.muted;
                        font-family: Typography.family;
                        font-size: 10.5px;
                        vertical-alignment: center;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: Layout.icon-button;
                    height: Layout.icon-button;
                    border-radius: 7px;
                    background: close-ta.has-hover ? Palette.surface-hover : transparent;
                    // lucide `X` (24-unit grid). Slint fits the glyph into
                    // width - stroke, so a 16.19px box (15 + 1.19 stroke)
                    // gives the reference 15px icon's ink and origin; it
                    // stays centred in the 28x28 button.
                    Path {
                        x: (parent.width - 16.19px) / 2;
                        y: (parent.height - 16.19px) / 2;
                        width: 16.19px;
                        height: 16.19px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        stroke-width: 1.19px;
                        stroke-line-cap: round;
                        stroke: close-ta.has-hover ? Palette.text : Palette.muted;
                        commands: "M 18 6 L 6 18 M 6 6 L 18 18";
                    }
                    close-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.select(0); root.closed(); }
                    }
                }
            }
        }

        // Appearance section. The reference .settings-section draws a 1px top
        // divider only (styles.css .settings-section), never a full border.
        Rectangle {
            background: Palette.surface;
            Rectangle {
                y: 0;
                width: parent.width;
                height: 1px;
                background: Palette.border-subtle;
            }

            VerticalLayout {
                padding-left: 21px;
                padding-right: 21px;
                padding-top: 14px;
                // Rendered appearance section was 115px vs the reference
                // 116px, and removing the accent row's 3px failed pad drops
                // another 1px, so 14px restores both (separator 275 vs 273).
                padding-bottom: 14px;
                // Reference: .settings-section-head has margin-bottom 7px,
                // but .settings-row has no gap between rows. Slint spacing
                // applies to every pair, so the head/theme gap is an explicit
                // 7px spacer below and the rows sit flush.
                spacing: 0px;

                HorizontalLayout {
                    Text {
                        text: "APPEARANCE";
                        color: Palette.muted;
                        font-family: Typography.family;
                        font-size: 9.5px;
                        font-weight: 600;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.accent-label;
                        color: Palette.muted-2;
                        font-family: Typography.family;
                        font-size: 9.5px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 7px; }

                // Theme row.
                HorizontalLayout {
                    height: 35px;
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Theme";
                            color: Palette.text-soft;
                            font-family: Typography.family;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Soft light or low-contrast dark surfaces.";
                            color: Palette.muted-2;
                            font-family: Typography.family;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 116px;
                        height: 29px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: Palette.border-subtle;
                        background: Palette.surface-2;
                        theme-group := HorizontalLayout {
                            x: 2px;
                            y: 2px;
                            spacing: 2px;
                            for segment[i] in [false, true] : Rectangle {
                                width: 55px;
                                height: 25px;
                                border-radius: 5px;
                                border-width: 1px;
                                border-color: root.focus-index == (segment ? 2 : 1)
                                    ? Palette.accent
                                    : ((root.light == segment) ? Palette.border : transparent);
                                background: (root.light == segment || root.focus-index == (segment ? 2 : 1))
                                    ? Palette.surface : transparent;
                                segment-text := Text {
                                    text: segment ? "Light" : "Dark";
                                    color: (root.light == segment) ? Palette.text : Palette.muted;
                                    font-family: Typography.family;
                                    font-size: 10.5px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select(segment ? 2 : 1); root.theme-changed(segment); }
                                }
                            }
                        }
                    }
                }

                // Accent row.
                HorizontalLayout {
                    // Round-5 render: the group sat at x~588 and the coloured
                    // bbox at 585..767, i.e. +4.5px from the target. The row
                    // content edge is fixed, so 5.5px right padding (1px + the
                    // measured 4.5px) puts the custom button back on x776..800
                    // and the first swatch button on x584.
                    padding-right: 5.5px;
                    height: 35px;
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Accent";
                            color: Palette.text-soft;
                            font-family: Typography.family;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Used for controls and the live spectrum.";
                            color: Palette.muted-2;
                            font-family: Typography.family;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    HorizontalLayout {
                        spacing: 0px;
                        alignment: end;
                        // Reference .settings-row aligns its items on the
                        // cross axis; Slint stretches children by default,
                        // which top-aligned the 24px swatches in the 35px row.
                        cross-axis-self-alignment: center;
                        for swatch[i] in [
                            { n: 0, c: #f2486f },
                            { n: 1, c: #3b82f6 },
                            { n: 2, c: #2fa572 },
                            { n: 3, c: #12a8a0 },
                            { n: 4, c: #d4922a },
                            { n: 5, c: #8b7cf6 },
                        ] : Rectangle {
                            // 24px control + the reference 8px gap, so the
                            // gaps do not rely on layout `spacing` (the hidden
                            // hex field must contribute no gap at all).
                            width: 32px;
                            height: 24px;
                            SwatchButton {
                                swatch: swatch.c;
                                pressed: !root.custom-accent && root.accent-index == swatch.n;
                                focused: root.focus-index == swatch.n + 3;
                                picked => { root.select(swatch.n + 3); root.accent-chosen(swatch.n); }
                            }
                        }
                        SwatchButton {
                            swatch: Palette.accent;
                            custom: true;
                            pressed: root.custom-accent;
                            focused: root.focus-index == 9;
                            picked => { root.select(9); root.custom-accent-clicked(); }
                        }
                        // Hex field for the custom accent, matching the
                        // reference colour input (`#rrggbb`, applied as
                        // typed; invalid or unfinished text is not applied).
                        // `visible` (not a conditional) keeps the field
                        // addressable from the text-restore handler. The
                        // wrapper is 0 wide unless custom mode is active: a
                        // `visible: false` layout child still reserves its
                        // 78px + 8px gap, which pushed the seven swatches
                        // 86px left of the reference row.
                        Rectangle {
                            width: root.custom-accent ? 86px : 0px;
                            height: 24px;
                            Rectangle {
                                visible: root.custom-accent;
                                x: 8px;
                                width: 78px;
                                height: 24px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: hex-input.has-focus ? Palette.accent : Palette.border;
                                background: Palette.surface-2;
                                hex-input := TextInput {
                                    x: 8px;
                                    width: parent.width - 12px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    text: root.custom-hex-text;
                                    color: Palette.text;
                                    font-family: Typography.family;
                                    font-size: 10.5px;
                                    edited => { root.custom-accent-text-changed(self.text); }
                                    accepted => { root.custom-accent-text-changed(self.text); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Presets section.
        Rectangle {
            background: Palette.surface;
            Rectangle {
                y: 0;
                width: parent.width;
                height: 1px;
                background: Palette.border-subtle;
            }

            VerticalLayout {
                padding-left: 21px;
                padding-right: 21px;
                padding-top: 14px;
                // Rendered presets section was 100px vs the reference 101px
                // (separator 375 vs 374); 13px restores the 1px.
                padding-bottom: 13px;
                spacing: 9px;
                HorizontalLayout {
                    Text {
                        text: "PRESETS";
                        color: Palette.muted;
                        font-family: Typography.family;
                        font-size: 9.5px;
                        font-weight: 600;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: "Factory files stay untouched";
                        color: Palette.muted-2;
                        font-family: Typography.family;
                        font-size: 9.5px;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: "Save the current effects and EQ as a custom preset, or move presets in and out as .fac files.";
                    color: Palette.muted;
                    font-family: Typography.family;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 7px;
                    for action[i] in [0, 1, 2] : Rectangle {
                        horizontal-stretch: 1;
                        height: 32px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.focus-index == 11 + i
                            ? Palette.accent
                            : (i == 2 ? Palette.accent-border
                                : (action-ta.has-hover ? Palette.border-strong : Palette.border));
                        // styles.css .action-button:hover / .action-button-accent:hover.
                        background: action-ta.has-hover || root.focus-index == 11 + i
                            ? (i == 2 ? Palette.accent-wash : Palette.surface-hover)
                            : Palette.surface-2;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;
                            // `cross-axis-alignment: center`: without it the
                            // fixed-height 14px icon is pinned to the button's
                            // top edge while the text stays centred, which read
                            // as the icon floating above the label.
                            cross-axis-alignment: center;
                            // lucide `Upload` / `Download` / `Save`, as the
                            // reference action buttons render them.
                            Path {
                                width: 14px;
                                height: 14px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                // lucide Upload/Download/Save are 14px with a
                                // 1.9-unit stroke; Slint takes px, so 1.11.
                                stroke-width: 1.11px;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                                // styles.css .action-button-accent > svg colors
                                // the save glyph with the accent.
                                stroke: i == 2 ? Palette.accent : Palette.text-soft;
                                // Import/Export keep their arc-free tray
                                // glyphs; the save glyph is the lucide save
                                // icon redrawn with cubics (Slint paths have
                                // no arc command).
                                commands: i == 0
                                    ? "M 21 15 L 21 19 C 21 20.1 20.1 21 19 21 L 5 21 C 3.9 21 3 20.1 3 19 L 3 15 M 17 8 L 12 3 L 7 8 M 12 3 L 12 15"
                                    : (i == 1
                                        ? "M 21 15 L 21 19 C 21 20.1 20.1 21 19 21 L 5 21 C 3.9 21 3 20.1 3 19 L 3 15 M 7 10 L 12 15 L 17 10 M 12 15 L 12 3"
                                        : "M 15 3 L 16.5 3 C 17 3 17.4 3.2 17.7 3.5 L 20.5 6.3 C 20.8 6.6 21 7 21 7.5 L 21 19 C 21 20.1 20.1 21 19 21 L 5 21 C 3.9 21 3 20.1 3 19 L 3 5 C 3 3.9 3.9 3 5 3 Z M 17 21 L 17 14 C 17 13.4 16.6 13 16 13 L 8 13 C 7.4 13 7 13.4 7 14 L 7 21 M 7 3 L 7 7 C 7 7.6 7.4 8 8 8 L 15 8 C 15.6 8 16 7.6 16 7 L 16 3");
                            }
                            Text {
                                height: 16px;
                                text: i == 0 ? "Import" : (i == 1 ? "Export" : "Save preset");
                                color: i == 2 ? Palette.text : Palette.text-soft;
                                font-family: Typography.family;
                                font-size: 10.5px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        action-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.select(11 + i);
                                if (i == 0) { root.import-clicked(); }
                                if (i == 1) { root.export-clicked(); }
                                if (i == 2) { root.save-opened(); }
                            }
                        }
                    }
                }
            }
        }

        // Start at login row.
        Rectangle {
            background: Palette.surface;
            Rectangle {
                y: 0;
                width: parent.width;
                height: 1px;
                background: Palette.border-subtle;
            }

            // Reference: .settings-section-last owns the 14px/13px padding
            // and the 35px row sits inside it. Putting both on one layout made
            // the row 35px *including* the 27px padding, clipping the two text
            // lines into a grey bar and losing 7px of dialog height.
            VerticalLayout {
                padding-left: 21px;
                padding-right: 21px;
                // 14px below the 1px section divider (the divider overlays the
                // first row of the padding).
                padding-top: 15px;
                // Rendered autostart section was 62px vs the reference 63px
                // (footer separator 437); round 6's 12px was a failed guess,
                // so this returns to the reference 13px.
                padding-bottom: 13px;
                HorizontalLayout {
                    height: 35px;
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Start at login";
                            color: Palette.text-soft;
                            font-family: Typography.family;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Keep the engine ready in the background.";
                            color: Palette.muted-2;
                            font-family: Typography.family;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    switch := Rectangle {
                        width: 34px;
                        height: 20px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.focus-index == 10 ? Palette.accent : Palette.border;
                        background: Palette.track;
                        Rectangle {
                            width: 14px;
                            height: 14px;
                            y: 2px;
                            x: root.autostart ? parent.width - 17px : 2px;
                            border-radius: 7px;
                            background: Palette.muted-2;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.select(10); root.autostart-changed(!root.autostart); }
                        }
                    }
                }
            }
        }

        // Footer: version + quit.
        Rectangle {
            background: Palette.surface;
            Rectangle {
                y: 0;
                width: parent.width;
                height: 1px;
                background: Palette.border-subtle;
            }

            HorizontalLayout {
                padding-left: 21px;
                padding-right: 21px;
                // 12px below the 1px footer divider, as .settings-footer. The
                // rendered footer was 42px vs the reference 44px; 13px top and
                // 13px bottom restore the two missing pixels.
                padding-top: 13px;
                padding-bottom: 13px;
                spacing: 7px;
                Text {
                    text: "SauceFX " + root.version;
                    color: Palette.muted-2;
                    font-family: Typography.family;
                    font-size: 9.5px;
                    vertical-alignment: center;
                }
                // The reference footer separates the version and licence with
                // a text "·" whose font metrics centre it; a fixed-height
                // rectangle in this layout gets pinned to the row top.
                Text {
                    text: "\u{00b7}";
                    color: Palette.muted-2;
                    font-family: Typography.family;
                    font-size: 9.5px;
                    vertical-alignment: center;
                }
                Text {
                    text: "AGPL-3.0";
                    color: Palette.muted-2;
                    font-family: Typography.family;
                    font-size: 9.5px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: quit-text.width;
                    height: 20px;
                    background: transparent;
                    quit-text := Text {
                        text: "Quit SauceFX";
                        color: quit-ta.has-hover || root.focus-index == 14 ? Palette.danger : Palette.muted;
                        font-family: Typography.family;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    quit-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.select(14); root.quit-clicked(); }
                    }
                }
            }
        }
    }

    // The section backgrounds are painted over the root's own border, so draw
    // the reference 1px card outline last, on top of the content. It is
    // absolutely placed and does not affect the layout or focus.
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        border-radius: 14px;
        border-width: 1px;
        border-color: Palette.border;
        background: transparent;
    }
}
