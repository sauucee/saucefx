// Source-equivalent Save preset dialog (frontend/src/components/SavePresetDialog.tsx
// + .save-dialog styles): name field with help/error text, Cancel and a Save
// button that stays disabled until the name is present and not taken.
//
// Event ownership: the whole dialog lives *inside* the `fs` FocusScope, so the
// scope is the ancestor of every focusable descendant and therefore receives
// capture-key-pressed (Escape/Tab/Backtab) no matter which control was clicked.
import { Layout, Palette, Typography } from "palette.slint";

export component SavePresetDialog inherits Rectangle {
    in property <string> name: "";
    in property <bool> valid: false;
    in property <string> error: "";
    in property <string> help: "";
    callback name-changed(string);
    callback cancelled();
    callback confirmed();

    callback focus-changed(string);

    // Traversal order follows the protected source DOM
    // (SavePresetDialog.tsx: Close at 63, autofocus Input at 71, Cancel at 96,
    // Save at 97): Close -> Input -> Cancel -> Save -> Close. Tab from the
    // initial Input therefore goes Cancel; Shift+Tab from Input goes Close.
    // A disabled Save is skipped in both directions.
    public function step-focus(delta: int) {
        if (delta > 0) {
            if (field.has-focus) {
                cancel-focus.focus();
            } else if (cancel-focus.has-focus) {
                if (root.valid) { save-focus.focus(); } else { close-focus.focus(); }
            } else if (save-focus.has-focus) {
                close-focus.focus();
            } else {
                field.focus();
            }
        } else {
            if (field.has-focus) {
                close-focus.focus();
            } else if (close-focus.has-focus) {
                if (root.valid) { save-focus.focus(); } else { cancel-focus.focus(); }
            } else if (save-focus.has-focus) {
                cancel-focus.focus();
            } else {
                field.focus();
            }
        }
    }

    public function focus-modal() {
        field.focus();
        root.focus-changed("save:input");
    }

    // One routing table for the modal keys. `capture-key-pressed` on the scope
    // and the per-control `key-pressed` fallbacks all call it, so Escape and
    // Tab/Backtab behave the same no matter which descendant is focused (or
    // which of the two dispatch paths the backend delivers).
    public function handle-modal-key(text: string, shift: bool) -> bool {
        if (text == "\u{001b}") {
            root.cancelled();
            return true;
        }
        if (text == "\u{0009}" && !shift) {
            root.step-focus(1);
            return true;
        }
        // winit/X11 reports Shift+Tab as "\t" plus the shift modifier; other
        // backends deliver the Backtab code point instead.
        if (text == "\u{0019}" || (text == "\u{0009}" && shift)) {
            root.step-focus(-1);
            return true;
        }
        return false;
    }

    public pure function report() -> string {
        return save-focus.has-focus ? "save:save"
            : cancel-focus.has-focus ? "save:cancel"
            : close-focus.has-focus ? "save:close"
            : field.has-focus ? "save:input" : "save:none";
    }

    changed visible => { if (self.visible) { root.focus-modal(); } }

    width: 424px;
    height: content.preferred-height;
    border-radius: 14px;
    background: Palette.surface;
    border-width: 1px;
    border-color: Palette.border;

    fs := FocusScope {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        // Capture runs window -> focused item before key-pressed, so Tab and
        // Backtab are handled here instead of the window's built-in focus walk
        // (which used to escape into the background EQ).
        capture-key-pressed(event) => {
            if (root.handle-modal-key(event.text, event.modifiers.shift)) {
                return accept;
            }
            reject
        }

        // Bubbling fallback: fs is the ancestor of every focusable descendant,
        // so even when a control consumes Tab or capture is skipped this still
        // receives Escape/Tab/Backtab before the window's built-in focus walk
        // can move focus into the equalizer behind the modal.
        key-pressed(event) => {
            if (root.handle-modal-key(event.text, event.modifiers.shift)) {
                return accept;
            }
            reject
        }

        // Keeps pointer clicks on the dialog card inside the dialog (and away
        // from the Settings layer underneath) without activating anything. The
        // card takes the dialog's initial focus so the Tab chain always starts
        // from a real target instead of leaving the report empty.
        card-block := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.focus-modal(); }
        }

        content := VerticalLayout {
            spacing: 0px;

            // Header.
            Rectangle {
                background: Palette.surface;

                HorizontalLayout {
                    // The 424px dialog is wider than this row's content; the
                    // layout must own the full width or the close button is
                    // pushed left/right by the description width (rendered X
                    // sat at x700 instead of x692).
                    width: parent.width;
                    padding-left: 21px;
                    // Compensate for the 1px dialog border not being an
                    // inset (reference close button x682).
                    padding-right: 22px;
                    padding-top: 19px;
                    padding-bottom: 14px;
                    spacing: 20px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text {
                            text: "Save preset";
                            color: Palette.text;
                            font-family: Typography.family;
                            font-size: 17px;
                            font-weight: 600;
                            letter-spacing: -0.1px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Creates a new custom preset. Factory presets are never overwritten.";
                            color: Palette.muted;
                            font-family: Typography.family;
                            font-size: 10.5px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: Layout.icon-button;
                        height: Layout.icon-button;
                        border-radius: 7px;
                        background: close-ta.has-hover || close-focus.has-focus ? Palette.surface-hover : transparent;
                        border-width: 1px;
                        border-color: close-focus.has-focus ? Palette.accent : transparent;
                        // lucide `X`; the 16.19px box (15 + 1.19 stroke)
                        // restores the reference glyph ink and origin under
                        // Slint's stroke-inset viewbox fit.
                        Path {
                            x: (parent.width - 16.19px) / 2;
                            y: (parent.height - 16.19px) / 2;
                            width: 16.19px;
                            height: 16.19px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            stroke-width: 1.19px;
                            stroke-line-cap: round;
                            stroke: close-ta.has-hover ? Palette.text : Palette.muted;
                            commands: "M 18 6 L 6 18 M 6 6 L 18 18";
                        }
                        close-focus := FocusScope {
                            accessible-role: button;
                            accessible-label: "Close save dialog";
                            accessible-action-default => { root.cancelled(); }
                            width: parent.width;
                            height: parent.height;
                            changed has-focus => {
                                if (self.has-focus) { root.focus-changed("save:close"); }
                            }
                            key-pressed(event) => {
                                if (root.handle-modal-key(event.text, event.modifiers.shift)) {
                                    return accept;
                                }
                                if (event.text == "\u{000a}" || event.text == "\u{0020}") {
                                    root.cancelled();
                                    return accept;
                                }
                                reject
                            }
                        }
                        close-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                close-focus.focus();
                                root.cancelled();
                            }
                        }
                    }
                }
            }

            // Body: name field + help/error.
            Rectangle {
                background: Palette.surface;

                VerticalLayout {
                    padding-left: 21px;
                    padding-right: 21px;
                    padding-top: 2px;
                    padding-bottom: 18px;
                    spacing: 0px;
                    // styles.css .field-label: 10px/600 uppercase with 0.11em
                    // letter-spacing (1.1px at this size).
                    Text {
                        text: "PRESET NAME";
                        color: Palette.muted;
                        font-family: Typography.family;
                        font-size: 10px;
                        font-weight: 600;
                        letter-spacing: 1.1px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 38px;
                        border-radius: 7px;
                        border-width: 1px;
                        // styles.css .text-input:hover adds border-strong, and
                        // the later :focus rule wins when both apply; the
                        // hover TouchArea sits *behind* the TextInput so the
                        // input keeps every click for cursor placement.
                        border-color: root.error != "" ? Palette.danger
                            : field.has-focus ? Palette.accent-border
                            : (hover-ta.has-hover ? Palette.border-strong : Palette.border);
                        background: Palette.input-bg;
                        hover-ta := TouchArea { }
                        // styles.css .text-input:focus adds a 3px accent-wash
                        // box-shadow outside the border. Drawn as a ring over
                        // the field: its stroke lands in the 3px band outside
                        // the 7px-radius box, its inner area stays transparent.
                        if field.has-focus && root.error == "" : Rectangle {
                            x: 0px - 3px;
                            y: 0px - 3px;
                            width: parent.width + 6px;
                            height: parent.height + 6px;
                            border-radius: 10px;
                            border-width: 3px;
                            border-color: Palette.accent-wash;
                            background: transparent;
                        }
                        field := TextInput {
                            accessible-label: "Preset name";
                            x: 10px;
                            width: parent.width - 20px;
                            height: parent.height;
                            text: root.name;
                            color: Palette.text;
                            font-family: Typography.family;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                            changed has-focus => {
                                if (self.has-focus) { root.focus-changed("save:input"); }
                            }
                            edited => { root.name-changed(self.text); }
                            accepted => {
                                if (root.valid) { root.confirmed(); }
                            }
                            key-pressed(event) => {
                                // Escape/Tab are modal keys even while the text
                                // field owns focus; everything else is typed.
                                if (root.handle-modal-key(event.text, event.modifiers.shift)) {
                                    return accept;
                                }
                                reject
                            }
                        }
                    }
                    // styles.css .field-help: 7px top margin and line-height
                    // 1.4. Without it the dialog is ~10px shorter than the
                    // reference, so centring puts the whole header (and the
                    // close X) 5px too low.
                    Rectangle { height: 7px; }
                    Text {
                        height: 14px;
                        text: root.error != "" ? root.error : root.help;
                        color: root.error != "" ? Palette.danger : Palette.muted-2;
                        font-family: Typography.family;
                        font-size: 9.5px;
                        vertical-alignment: center;
                    }
                }
            }

            // Footer: Cancel + Save.
            Rectangle {
                border-width: 1px;
                border-color: Palette.border-subtle;
                background: Palette.surface;

                HorizontalLayout {
                    padding-left: 21px;
                    padding-right: 21px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 7px;
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: cancel-text.preferred-width + 24px;
                        height: 31px;
                        border-radius: 6px;
                        border-width: 1px;
                        // styles.css .button-secondary:hover also lifts the
                        // border to border-strong.
                        border-color: cancel-focus.has-focus ? Palette.accent
                            : (cancel-ta.has-hover ? Palette.border-strong : Palette.border);
                        background: cancel-ta.has-hover ? Palette.surface-hover : Palette.surface-2;
                        cancel-text := Text {
                            text: "Cancel";
                            color: Palette.text-soft;
                            font-family: Typography.family;
                            font-size: 10.5px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cancel-focus := FocusScope {
                            accessible-role: button;
                            accessible-label: "Cancel";
                            accessible-action-default => { root.cancelled(); }
                            width: parent.width;
                            height: parent.height;
                            changed has-focus => {
                                if (self.has-focus) { root.focus-changed("save:cancel"); }
                            }
                            key-pressed(event) => {
                                if (root.handle-modal-key(event.text, event.modifiers.shift)) {
                                    return accept;
                                }
                                if (event.text == "\u{000a}" || event.text == "\u{0020}") {
                                    root.cancelled();
                                    return accept;
                                }
                                reject
                            }
                        }
                        cancel-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                cancel-focus.focus();
                                root.cancelled();
                            }
                        }
                    }
                    Rectangle {
                        width: save-text.preferred-width + 24px;
                        height: 31px;
                        border-radius: 6px;
                        // styles.css .button-primary:hover mixes 12% white into
                        // the accent.
                        background: save-ta.has-hover
                            ? Palette.accent.mix(#ffffff, 0.12)
                            : Palette.accent;
                        opacity: root.valid ? 1 : 0.46;
                        border-width: 1px;
                        border-color: save-focus.has-focus ? Palette.accent-ink : transparent;
                        save-text := Text {
                            text: "Save preset";
                            color: Palette.accent-ink;
                            font-family: Typography.family;
                            font-size: 10.5px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        save-focus := FocusScope {
                            accessible-role: button;
                            accessible-label: "Save preset";
                            accessible-action-default => { if (root.valid) { root.confirmed(); } }
                            width: parent.width;
                            height: parent.height;
                            changed has-focus => {
                                if (self.has-focus) { root.focus-changed("save:save"); }
                            }
                            key-pressed(event) => {
                                if (root.handle-modal-key(event.text, event.modifiers.shift)) {
                                    return accept;
                                }
                                if ((event.text == "\u{000a}" || event.text == "\u{0020}") && root.valid) {
                                    root.confirmed();
                                    return accept;
                                }
                                reject
                            }
                        }
                        save-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.valid) {
                                    save-focus.focus();
                                    root.confirmed();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // The body backgrounds are painted over the root's border; draw the 1px
    // card outline last so the Save dialog frame stays visible all round.
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        border-radius: 14px;
        border-width: 1px;
        border-color: Palette.border;
        background: transparent;
    }

    // Focus is granted by AppWindow when the dialog becomes visible, so the
    // hidden dialog never steals focus from the app at startup.
}
