// 31-band graphic EQ: frontend/src/components/Equalizer.tsx geometry, bands and
// ranges from data.ts (20 Hz..20 kHz, +-12 dB). The trace is a real path built
// from the 31 gain values by the binding layer.
import { Layout, Palette, Typography } from "palette.slint";

export component EqualizerPanel inherits Rectangle {
    in property <[float]> gains;
    in property <string> curve-commands;
    in property <string> fill-commands;
    in property <[string]> labels;
    in property <[float]> label-positions;
    in property <string> readout: "";
    in property <bool> enabled: true;
    in property <bool> keyboard-enabled: true;
    // Band whose readout is currently shown, mirroring Equalizer.tsx
    // `activeBand`. Slint sends the new cell's hover before the old cell's
    // exit, so exits must not clear a readout another cell already claimed.
    private property <int> active-band: -1;
    callback band-changed(int, float);
    callback band-hovered(int);
    callback band-blurred(int);
    callback band-stepped(int, int);
    callback band-reset(int);
    callback reset-all();

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-top: Layout.panel-head-pad-top;
        padding-left: Layout.panel-head-pad-h;
        padding-right: Layout.panel-head-pad-h;
        padding-bottom: 0px;
        // styles.css .eq-plot margin-top 2px between the head and the plot.
        spacing: 2px;

        HorizontalLayout {
            spacing: 8px;
            // styles.css `.eq-panel-head` padding is `14px 15px 4px`; the 4px
            // bottom edge is what puts the chart at the reference y=337.59
            // (measured DOM), so it belongs to the head, not to the plot.
            padding-bottom: 4px;
            VerticalLayout {
                spacing: 3px;
                Text {
                    text: "Equalizer";
                    color: Palette.text;
                    font-family: Typography.family;
                    font-size: Typography.title;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                // Equalizer.tsx replaces the subtitle with the hover/focus readout.
                Text {
                    text: root.readout == "" ? "31 bands \u{00b7} \u{00b1}12 dB" : root.readout;
                    color: root.readout == "" ? Palette.muted-2 : Palette.accent;
                    font-family: Typography.family;
                    font-size: Typography.small;
                    font-weight: root.readout == "" ? 400 : 600;
                    vertical-alignment: center;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            // styles.css .icon-button: 28x28, 6px radius, no border at rest.
            Rectangle {
                width: Layout.icon-button;
                height: Layout.icon-button;
                border-radius: 6px;
                background: reset-ta.has-hover && root.enabled ? Palette.surface-hover : transparent;
                opacity: root.enabled ? 1 : 0.4;
                Path {
                    x: (parent.width - 14px) / 2;
                    y: (parent.height - 14px) / 2;
                    width: 14px;
                    height: 14px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    // lucide RotateCcw (the reference reset glyph), counterclockwise.
                    stroke-width: 1.9px;
                    stroke: reset-ta.has-hover ? Palette.text : Palette.muted;
                    commands: "M 3 12 A 9 9 0 1 0 12 3 A 9.75 9.75 0 0 0 5.26 5.74 L 3 8 M 3 3 L 3 8 L 8 8";
                }
                reset-ta := TouchArea {
                    enabled: root.enabled;
                    mouse-cursor: root.enabled ? pointer : default;
                    clicked => { root.reset-all(); }
                }
            }
        }

        plot := Rectangle {
            vertical-stretch: 1;
            background: transparent;

        chart := Rectangle {
            x: 0;
            y: Layout.eq-chart-inset-top;
            width: parent.width - Layout.eq-chart-inset-right;
            height: parent.height - Layout.eq-chart-inset-top - Layout.eq-chart-inset-bottom;
            background: transparent;

            // Equalizer.tsx draws the guides in its 200-unit viewBox, stretched
            // to the plot: horizontal lines at viewBox y = 12/56/100/144/188
            // (the middle one is the stronger zero line) and vertical lines at
            // 20/40/60/80% of the width spanning y=12..188 with a 2px-on /
            // 4px-off dash. They are not at 0/25/50/75/100%.
            for i in 5 : Rectangle {
                x: 0;
                width: parent.width;
                height: 1px;
                y: parent.height * (12 + i * 44) / 200;
                background: i == 2 ? Palette.eq-zero : Palette.eq-grid;
            }

            for step[i] in [0.2, 0.4, 0.6, 0.8] : Rectangle {
                x: parent.width * step;
                width: 1px;
                height: parent.height;
                background: transparent;

                // Bounded dash repeat: viewBox y=12..188 in 6-unit steps.
                for dash[j] in 30 : Rectangle {
                    x: 0;
                    width: 1px;
                    height: 2px;
                    y: parent.height * (12 + j * 6) / 200;
                    visible: 12 + j * 6 + 2 <= 188;
                    background: Palette.eq-grid;
                }
            }

            // Equalizer.tsx draws the trace in a 1000x200 viewBox with
            // preserveAspectRatio="none", i.e. a plain stretch. Slint's Path
            // defaults to `fit: contain`, which preserves the aspect ratio, and
            // its fitted area is the element box minus the stroke width with a
            // half-stroke offset. Both are corrected here: `fit: fill` matches
            // the source, and growing each box by the stroke while shifting it
            // by half the stroke makes the fitted bounds exactly chart-sized, so
            // the curve, the thumbs and the hit cells agree.
            Path {
                x: 0px - Layout.eq-curve-stroke / 2;
                y: 0px - Layout.eq-curve-stroke / 2;
                width: parent.width + Layout.eq-curve-stroke;
                height: parent.height + Layout.eq-curve-stroke;
                commands: root.fill-commands;
                viewbox-width: 1000;
                viewbox-height: 200;
                fit: fill;
                fill: root.enabled ? Palette.accent.with-alpha(0.10) : transparent;
                stroke: transparent;
                stroke-width: Layout.eq-curve-stroke;
            }

            Path {
                x: 0px - Layout.eq-curve-stroke / 2;
                y: 0px - Layout.eq-curve-stroke / 2;
                width: parent.width + Layout.eq-curve-stroke;
                height: parent.height + Layout.eq-curve-stroke;
                commands: root.curve-commands;
                viewbox-width: 1000;
                viewbox-height: 200;
                fit: fill;
                stroke: root.enabled ? Palette.accent : Palette.muted-2;
                stroke-width: Layout.eq-curve-stroke;
                fill: transparent;
            }

            if !root.enabled : Text {
                text: "Paused";
                color: Palette.muted-2;
                font-family: Typography.family;
                font-size: 10px;
                font-weight: 600;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            // 31 focusable band sliders, 1 dB keyboard steps, right-click reset.
            // Equalizer.tsx .eq-band is `flex: 1 1 0`, so each band owns its
            // whole pitch slice: centres, gaps between thumbs and the plot
            // edges all land on a cell. Thumb/curve geometry is unchanged.
            for band[i] in Layout.eq-bands : Rectangle {
                x: (i * parent.width) / Layout.eq-bands;
                width: parent.width / Layout.eq-bands;
                height: parent.height;
                background: transparent;

                focus := FocusScope {
                    // Pointer focus is real focus so arrow keys work after a
                    // click, but the styles.css `:focus-visible` halo/readout
                    // affordance belongs to keyboard-acquired focus only.
                    private property <bool> keyboard-visible: false;
                    enabled: root.keyboard-enabled && root.enabled;
                    // Focus is taken explicitly on press so its reason is
                    // Programmatic, which Slint reports synchronously here.
                    focus-on-click: false;
                    width: parent.width;
                    height: parent.height;
                    focus-gained(reason) => {
                        if (reason == FocusReason.programmatic) {
                            self.keyboard-visible = false;
                        } else {
                            self.keyboard-visible = true;
                            root.active-band = i;
                            root.band-hovered(i);
                        }
                    }
                    focus-lost(reason) => {
                        self.keyboard-visible = false;
                        if (root.active-band == i) {
                            root.active-band = -1;
                            root.band-blurred(i);
                        }
                    }
                    key-pressed(event) => {
                        if (root.keyboard-enabled && root.enabled) {
                            // Slint 1.18 sends the arrow keys as U+F700
                            // (Up), U+F701 (Down), U+F702 (Left) and U+F703
                            // (Right), not as "ArrowUp"/"ArrowDown" text.
                            if (event.text == "\u{f700}" || event.text == "\u{f703}") {
                                self.keyboard-visible = true;
                                root.active-band = i;
                                root.band-hovered(i);
                                root.band-stepped(i, 1);
                                return accept;
                            }
                            if (event.text == "\u{f701}" || event.text == "\u{f702}") {
                                self.keyboard-visible = true;
                                root.active-band = i;
                                root.band-hovered(i);
                                root.band-stepped(i, -1);
                                return accept;
                            }
                            // The reference range input steps 10 dB per page
                            // key and jumps to its limits on Home/End (±24
                            // always clamps somewhere inside ±12).
                            if (event.text == Key.Home) {
                                self.keyboard-visible = true;
                                root.active-band = i;
                                root.band-hovered(i);
                                root.band-stepped(i, -24);
                                return accept;
                            }
                            if (event.text == Key.End) {
                                self.keyboard-visible = true;
                                root.active-band = i;
                                root.band-hovered(i);
                                root.band-stepped(i, 24);
                                return accept;
                            }
                            if (event.text == Key.PageUp || event.text == Key.PageDown) {
                                self.keyboard-visible = true;
                                root.active-band = i;
                                root.band-hovered(i);
                                root.band-stepped(i, event.text == Key.PageUp ? 10 : -10);
                                return accept;
                            }
                        }
                        reject
                    }
                }

                // styles.css .eq-thumb: 6x6 circle, 1.5px surface ring, 1.3x
                // on hover/focus, 1.5x while dragging, .35 opacity when disabled.
                // Slint has no transform, so the scaled states grow the geometry.
                // styles.css .eq-thumb: the accent disk is 6px and the 1.5px
                // surface ring is a box-shadow, i.e. outside the disk. Drawing
                // it as a 1.5px border shrank the pink core to 2px, so the ring
                // is a separate circle behind the disk. Both stay centred on the
                // same point, so band centres and hit cells are untouched.
                Rectangle {
                    property <length> thumb-size: touch.pressed ? 9px : (touch.has-hover || focus.keyboard-visible ? 8px : 6px);
                    property <length> ring-size: 1.5px;
                    property <length> centre: max(thumb-size / 2 + ring-size, min(parent.height - thumb-size / 2 - ring-size, (12 + (12 - root.gains[i]) / 24 * 176) / 200 * parent.height));
                    x: (parent.width - thumb-size - ring-size * 2) / 2;
                    y: centre - (thumb-size / 2) - ring-size;
                    width: thumb-size + ring-size * 2;
                    height: thumb-size + ring-size * 2;
                    border-radius: (thumb-size + ring-size * 2) / 2;
                    background: Palette.surface;
                    opacity: root.enabled ? 1 : 0.35;
                }
                Rectangle {
                    property <length> thumb-size: touch.pressed ? 9px : (touch.has-hover || focus.keyboard-visible ? 8px : 6px);
                    property <length> ring-size: 1.5px;
                    property <length> centre: max(thumb-size / 2 + ring-size, min(parent.height - thumb-size / 2 - ring-size, (12 + (12 - root.gains[i]) / 24 * 176) / 200 * parent.height));
                    x: (parent.width - thumb-size) / 2;
                    y: centre - thumb-size / 2;
                    width: thumb-size;
                    height: thumb-size;
                    border-radius: thumb-size / 2;
                    background: root.enabled ? Palette.accent : Palette.muted-2;
                    opacity: root.enabled ? 1 : 0.35;
                }

                // accent-wash focus/drag halo behind the thumb.
                if focus.keyboard-visible || touch.pressed : Rectangle {
                    property <length> halo-size: 15px;
                    x: (parent.width - halo-size) / 2;
                    y: max(0px, min(parent.height - halo-size, (12 + (12 - root.gains[i]) / 24 * 176) / 200 * parent.height - halo-size / 2));
                    width: halo-size;
                    height: halo-size;
                    border-radius: halo-size / 2;
                    border-width: 4px;
                    border-color: Palette.accent-wash-strong;
                    background: transparent;
                }

                touch := TouchArea {
                    // A modal owns pointer editing too, not just the keyboard.
                    // Power alone is not enough while a grab is still active.
                    enabled: root.enabled && root.keyboard-enabled;
                    mouse-cursor: root.enabled && root.keyboard-enabled ? ns-resize : default;
                    changed has-hover => {
                        if (self.has-hover) {
                            root.active-band = i;
                            root.band-hovered(i);
                        } else {
                            // Equalizer.tsx onPointerLeave clears the hover
                            // readout, but only if no neighbouring cell already
                            // claimed it during the same move. The real focus
                            // stays on this band so Up/Down still target a
                            // clicked band after the pointer leaves; the halo
                            // and readout stay hidden because keyboard-visible
                            // is still false.
                            if (root.active-band == i) {
                                root.active-band = -1;
                                root.band-blurred(i);
                            }
                        }
                    }
                    moved => {
                        if (self.pressed && root.enabled && root.keyboard-enabled) {
                            let gain = 12 - ((self.mouse-y / self.height * 200 - 12) / 176) * 24;
                            root.band-changed(i, max(-12, min(12, round(gain))));
                        }
                    }
                    clicked => {
                        if (root.enabled && root.keyboard-enabled) {
                            root.active-band = i;
                            root.band-hovered(i);
                            let gain = 12 - ((self.mouse-y / self.height * 200 - 12) / 176) * 24;
                            root.band-changed(i, max(-12, min(12, round(gain))));
                        }
                    }
                    double-clicked => {
                        if (root.enabled && root.keyboard-enabled) { root.band-reset(i); }
                    }
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.move) {
                            root.active-band = i;
                            root.band-hovered(i);
                        }
                        if (event.kind == PointerEventKind.down && root.enabled && root.keyboard-enabled) {
                            if (event.button == PointerEventButton.left) {
                                // Programmatic focus so focus-gained can tell a
                                // press apart from Tab navigation.
                                focus.focus();
                            } else if (event.button == PointerEventButton.right) {
                                root.band-reset(i);
                            }
                        }
                    }
                }

            }
        }

        // 11 frequency labels along the same band positions (Equalizer.tsx:186-194)
        // and the right-hand dB scale, both anchored to the plot bottom.
        label-row := Rectangle {
            x: 0;
            y: parent.height - Layout.eq-frequency-height;
            width: parent.width - Layout.eq-chart-inset-right;
            height: Layout.eq-frequency-height;
            background: transparent;
            for label[i] in labels : Text {
                text: label;
                color: Palette.muted-2;
                font-family: Typography.family;
                font-size: 8.5px;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: parent.width * (i < label-positions.length ? label-positions[i] : 0) - self.width / 2;
                width: 40px;
                height: parent.height;
            }
        }

        // styles.css .eq-scale: 19px wide, top 3px, bottom 20px, three labels
        // distributed space-between (+12 / 0 / -12).
        Rectangle {
            x: parent.width - Layout.eq-scale-width;
            y: Layout.eq-chart-inset-top;
            width: Layout.eq-scale-width;
            height: parent.height - Layout.eq-chart-inset-top - Layout.eq-chart-inset-bottom;
            background: transparent;
            Text {
                text: "+12";
                x: 0;
                y: 0;
                width: parent.width;
                height: 8.5px;
                color: Palette.muted-2;
                font-family: Typography.family;
                font-size: 8.5px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Text {
                text: "0";
                x: 0;
                y: (parent.height - 8.5px) / 2;
                width: parent.width;
                height: 8.5px;
                color: Palette.muted-2;
                font-family: Typography.family;
                font-size: 8.5px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Text {
                text: "\u{2212}12";
                x: 0;
                y: parent.height - 8.5px;
                width: parent.width;
                height: 8.5px;
                color: Palette.muted-2;
                font-family: Typography.family;
                font-size: 8.5px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        }
    }

    public function drag(x: length, y: length) {
        if (chart.width <= 0px || chart.height <= 0px) {
            return;
        }
        let band = round((x / chart.width) * (Layout.eq-bands - 1));
        let gain = max(-12, min(12, 12 - (y / chart.height) * 24));
        band-changed(clamp(band, 0, Layout.eq-bands - 1), gain);
    }

    pure function clamp(value: int, low: int, high: int) -> int {
        return max(low, min(high, value));
    }
}